9. COMPLETE GOOGLE APPS SCRIPTS
onFormSubmit()

function onFormSubmit(e) {

  const formData = e.namedValues;

  reduceInventory("Oats",
    parseFloat(formData["Oats Qty"][0]));

  reduceInventory("Barley",
    parseFloat(formData["Barley Qty"][0]));

  generateReorderAlert();

  updateDashboard();

}

reduceInventory()

function reduceInventory(itemName, qty) {

  const ss =
    SpreadsheetApp.getActiveSpreadsheet();

  const stockSheet =
    ss.getSheetByName("inventory_stock");

  const data =
    stockSheet.getDataRange().getValues();

  for (let i = 1; i < data.length; i++) {

    if (data[i][1] == itemName) {

      let currentStock =
        parseFloat(data[i][2]);

      let newStock =
        currentStock - qty;

      stockSheet
        .getRange(i + 1, 3)
        .setValue(newStock);

      createInventoryTransaction(
        itemName,
        qty
      );

      break;

    }
  }
}

createInventoryTransaction()

function createInventoryTransaction(itemName, qty) {

  const ss =
    SpreadsheetApp.getActiveSpreadsheet();

  const txnSheet =
    ss.getSheetByName("inventory_transaction");

  txnSheet.appendRow([
    new Date(),
    itemName,
    qty,
    "CONSUMPTION"
  ]);

}

generateReorderAlert()

function generateReorderAlert() {

  const ss =
    SpreadsheetApp.getActiveSpreadsheet();

  const stockSheet =
    ss.getSheetByName("inventory_stock");

  const data =
    stockSheet.getDataRange().getValues();

  for (let i = 1; i < data.length; i++) {

    const item = data[i][1];

    const stock = data[i][2];

    const reorder = data[i][3];

    if (stock <= reorder) {

      MailApp.sendEmail(
        "manager@stable.com",
        "LOW STOCK ALERT",
        item + " stock is low"
      );

    }
  }
}

calculateDaysWorked()

function calculateDaysWorked(joinDate) {

  const today = new Date();

  const joining = new Date(joinDate);

  const diffTime =
    Math.abs(today - joining);

  const diffDays =
    Math.ceil(diffTime /
      (1000 * 60 * 60 * 24));

  return diffDays;

}

updateStaffStatus()

function updateStaffStatus(staffId, status) {

  const ss =
    SpreadsheetApp.getActiveSpreadsheet();

  const sheet =
    ss.getSheetByName("staff_master");

  const data =
    sheet.getDataRange().getValues();

  for (let i = 1; i < data.length; i++) {

    if (data[i][0] == staffId) {

      sheet
        .getRange(i + 1, 6)
        .setValue(status);

      break;

    }
  }
}

